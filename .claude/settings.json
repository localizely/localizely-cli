{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go fmt:*)",
      "Bash(gofmt:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go mod download:*)",
      "Bash(go version)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(pwd)",
      "Bash(echo:*)"
    ],
    "ask": [
      "Edit(./**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(go get:*)",
      "Bash(go mod tidy:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.localizely/**)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(chmod:*)",
      "Bash(sudo:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)"
    ]
  }
}
